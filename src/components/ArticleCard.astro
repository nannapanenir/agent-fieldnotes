---
const { article } = Astro.props;
const date = article.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const href = `${import.meta.env.BASE_URL}learn/${article.id}/`;
---

<article class:list={['article-card', { 'is-security': article.data.topic === 'Security' }]}>
  <a class="article-card-link" href={href}>
    <div class="article-card-meta"><span>{article.data.topic}, {article.data.level.toLowerCase()} level</span></div>
    <h3>{article.data.title}</h3>
    <p>{article.data.description}</p>
    <div class="article-card-foot"><span>{date}</span><span>{article.data.readingMinutes ?? 5} min read</span></div>
  </a>
</article>

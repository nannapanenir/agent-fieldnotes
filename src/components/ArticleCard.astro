---
const { article, featured = false } = Astro.props;
const date = article.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const href = `${import.meta.env.BASE_URL}learn/${article.id}/`;
---

<article class:list={['article-card', { 'article-card-featured': featured }]}>
  <a class="article-card-link" href={href}>
    <div class="article-card-meta"><span class="topic-label">{article.data.topic}</span><span>{article.data.level}</span></div>
    <h3>{article.data.title}</h3>
    <p>{article.data.description}</p>
    <div class="article-card-foot"><span>{date}</span><span>{article.data.readingMinutes ?? 5} min read</span><span class="arrow" aria-hidden="true">↗</span></div>
  </a>
</article>

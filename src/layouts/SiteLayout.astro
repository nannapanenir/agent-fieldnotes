---
import '../styles/global.css';

const {
  title = 'Agent Fieldnotes — Understand agents. Build them responsibly.',
  description = 'A practical learning path through AI agents, architecture, frameworks, deployment, and security.',
  article = false,
  structuredData = null,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const homeUrl = base.endsWith('/') ? base : `${base}/`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const structuredDataText = structuredData ? JSON.stringify(structuredData).replaceAll('<', '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EAF0F2" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="Agent Fieldnotes" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structuredDataText && <script type="application/ld+json" set:html={structuredDataText}></script>}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${homeUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;600&display=swap" />
  </head>
  <body class:list={{ 'article-page': article }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={homeUrl} aria-label="Agent Fieldnotes home">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>agent<span class="brand-muted">fieldnotes</span></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href={`${homeUrl}learn/`}>Learning path</a>
          <a href={`${homeUrl}learn/#security`}>Security</a>
          <a href={`${homeUrl}about/`}>About</a>
        </nav>
        <div class="header-actions">
          <button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme">
            <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          </button>
          <a class="header-cta" href={`${homeUrl}learn/`}>Explore the guide <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="brand footer-brand" href={homeUrl}>
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>agent<span class="brand-muted">fieldnotes</span></span>
        </a>
        <p>Clear thinking for systems that can act.</p>
        <span class="footer-note">Built to learn in public · <span id="year">2026</span></span>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('.theme-toggle');
      const label = () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        toggle?.setAttribute('aria-label', `Switch to ${next} theme`);
      };
      label();
      toggle?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        label();
      });
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        if (!saved) { root.dataset.theme = event.matches ? 'light' : 'dark'; label(); }
      });
      const year = document.querySelector('#year');
      if (year) year.textContent = String(new Date().getFullYear());

      // Code tabs: a <div class="code-tabs"> holding a TypeScript block, then a Python block, becomes a tab switcher.
      // The chosen language applies to every group on the page and is remembered between visits.
      // Without JavaScript, the blocks stay stacked, each with a CSS language label.
      // Blocks that aren't code (two bash or text blocks, say) take their language from their position.
      const LANGUAGES: Record<string, { id: string; label: string }> = {
        ts: { id: 'typescript', label: 'TypeScript' },
        typescript: { id: 'typescript', label: 'TypeScript' },
        py: { id: 'python', label: 'Python' },
        python: { id: 'python', label: 'Python' },
      };
      const BY_POSITION = [LANGUAGES.typescript, LANGUAGES.python];
      const LANGUAGE_KEY = 'code-language';
      const groups = Array.from(document.querySelectorAll<HTMLElement>('.code-tabs'));
      const tabGroups: { tabs: HTMLButtonElement[]; panels: HTMLElement[]; languages: string[] }[] = [];

      const selectLanguage = (language: string, anchor?: HTMLElement) => {
        const before = anchor?.getBoundingClientRect().top;
        for (const group of tabGroups) {
          const index = Math.max(0, group.languages.indexOf(language));
          group.tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            group.panels[i].hidden = !selected;
          });
        }
        // Groups above the one clicked can change height; keep the clicked tab where it was.
        if (anchor && before !== undefined) window.scrollBy(0, anchor.getBoundingClientRect().top - before);
      };

      groups.forEach((group, groupIndex) => {
        const panels = Array.from(group.querySelectorAll<HTMLElement>(':scope > pre[data-language]'));
        if (panels.length < 2) return;
        const tablist = document.createElement('div');
        tablist.className = 'code-tabs-list';
        tablist.setAttribute('role', 'tablist');
        tablist.setAttribute('aria-label', 'Code language');
        const tabs: HTMLButtonElement[] = [];
        const languages: string[] = [];
        panels.forEach((panel, i) => {
          const raw = panel.dataset.language ?? '';
          const known = LANGUAGES[raw];
          const language = known && !languages.includes(known.id) ? known : (BY_POSITION[i] ?? { id: raw, label: raw });
          const tab = document.createElement('button');
          tab.type = 'button';
          tab.className = 'code-tab';
          tab.id = `code-tab-${groupIndex}-${i}`;
          tab.textContent = language.label;
          tab.setAttribute('role', 'tab');
          panel.id = `code-panel-${groupIndex}-${i}`;
          panel.setAttribute('role', 'tabpanel');
          panel.setAttribute('aria-labelledby', tab.id);
          tab.setAttribute('aria-controls', panel.id);
          tab.addEventListener('click', () => choose(language.id, tab));
          tab.addEventListener('keydown', (event) => {
            const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
            if (!(event.key in keys)) return;
            event.preventDefault();
            const next = tabs[(keys[event.key] + tabs.length) % tabs.length];
            next.focus();
            choose(languages[tabs.indexOf(next)], next);
          });
          tabs.push(tab);
          languages.push(language.id);
          tablist.append(tab);
        });
        group.prepend(tablist);
        group.classList.add('is-enhanced');
        tabGroups.push({ tabs, panels, languages });
      });

      function choose(language: string, anchor: HTMLElement) {
        selectLanguage(language, anchor);
        try { localStorage.setItem(LANGUAGE_KEY, language); } catch {}
      }

      if (tabGroups.length > 0) {
        let saved: string | null = null;
        try { saved = localStorage.getItem(LANGUAGE_KEY); } catch {}
        selectLanguage(saved ?? tabGroups[0].languages[0]);
      }
    </script>
  </body>
</html>


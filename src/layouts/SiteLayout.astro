---
import '../styles/global.css';
import FooterCredit from '../components/FooterCredit.astro';
// The two faces every page needs before first paint; fonts.css declares all three.
import archivoUrl from '../assets/fonts/archivo.woff2?url';
import sourceSerifUrl from '../assets/fonts/source-serif-4.woff2?url';
import { TOPICS } from '../lib/articles';

const {
  title = 'Agent Fieldnotes — Understand agents. Build them responsibly.',
  description = 'A practical learning path through AI agents, architecture, frameworks, deployment, and security.',
  article = false,
  structuredData = null,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const homeUrl = base.endsWith('/') ? base : `${base}/`;
const onLearningPath = Astro.url.pathname.replace(/\/?$/, '/') === `${homeUrl}learn/`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const structuredDataText = structuredData ? JSON.stringify(structuredData).replaceAll('<', '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EAF0F2" />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="Agent Fieldnotes" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structuredDataText && <script type="application/ld+json" set:html={structuredDataText}></script>}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${homeUrl}favicon.svg`} />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={sourceSerifUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body class:list={{ 'article-page': article }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-name" href={homeUrl}>Agent Fieldnotes</a>
        <nav class="site-nav" aria-label="Main">
          <a href={`${homeUrl}learn/`} aria-current={onLearningPath ? 'page' : undefined}>Learning path</a>
          <a href={`${homeUrl}learn/#topics`}>Topics</a>
          <a href={`${homeUrl}learn/#security`}>Security</a>
          <a href={`${homeUrl}about/`}>About</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="site-footer-about">
          <a class="site-name" href={homeUrl}>Agent Fieldnotes</a>
          <p>Clear thinking for systems that can act.</p>
        </div>
        <nav class="site-footer-links" aria-label="Learn">
          <span class="site-footer-heading">Learn</span>
          <a href={`${homeUrl}learn/`}>Learning path</a>
          <a href={`${homeUrl}learn/#topics`}>All notes</a>
          <a href={`${homeUrl}learn/foundations/agentic-ai-glossary/`}>Glossary</a>
        </nav>
        <nav class="site-footer-links" aria-label="Topics">
          <span class="site-footer-heading">Topics</span>
          {TOPICS.map((topic) => (
            <a class:list={{ 'is-security': topic.slug === 'security' }} href={`${homeUrl}learn/#${topic.slug}`}>{topic.name}</a>
          ))}
        </nav>
        <nav class="site-footer-links" aria-label="Site">
          <span class="site-footer-heading">Site</span>
          <a href={`${homeUrl}about/`}>About</a>
          <a href="https://github.com/nannapanenir/agent-fieldnotes">GitHub</a>
        </nav>
      </div>
      <div class="site-footer-note">
        <span>Written and drawn in public, {new Date().getFullYear()}</span>
        <FooterCredit />
      </div>
    </footer>
    <script>
      // Code tabs: a <div class="code-tabs"> holding a TypeScript block, then a Python block, becomes a tab switcher.
      // The chosen language applies to every group on the page and is remembered between visits.
      // Without JavaScript, the blocks stay stacked, each with a CSS language label.
      // Blocks that aren't code (two bash or text blocks, say) take their language from their position.
      const LANGUAGES: Record<string, { id: string; label: string }> = {
        ts: { id: 'typescript', label: 'TypeScript' },
        typescript: { id: 'typescript', label: 'TypeScript' },
        py: { id: 'python', label: 'Python' },
        python: { id: 'python', label: 'Python' },
      };
      const BY_POSITION = [LANGUAGES.typescript, LANGUAGES.python];
      const LANGUAGE_KEY = 'code-language';
      const groups = Array.from(document.querySelectorAll<HTMLElement>('.code-tabs'));
      const tabGroups: { tabs: HTMLButtonElement[]; panels: HTMLElement[]; languages: string[] }[] = [];

      const selectLanguage = (language: string, anchor?: HTMLElement) => {
        const before = anchor?.getBoundingClientRect().top;
        for (const group of tabGroups) {
          const index = Math.max(0, group.languages.indexOf(language));
          group.tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            group.panels[i].hidden = !selected;
          });
        }
        // Groups above the one clicked can change height; keep the clicked tab where it was.
        if (anchor && before !== undefined) window.scrollBy(0, anchor.getBoundingClientRect().top - before);
      };

      groups.forEach((group, groupIndex) => {
        const panels = Array.from(group.querySelectorAll<HTMLElement>(':scope > pre[data-language]'));
        if (panels.length < 2) return;
        const tablist = document.createElement('div');
        tablist.className = 'code-tabs-list';
        tablist.setAttribute('role', 'tablist');
        tablist.setAttribute('aria-label', 'Code language');
        const tabs: HTMLButtonElement[] = [];
        const languages: string[] = [];
        panels.forEach((panel, i) => {
          const raw = panel.dataset.language ?? '';
          const known = LANGUAGES[raw];
          const language = known && !languages.includes(known.id) ? known : (BY_POSITION[i] ?? { id: raw, label: raw });
          const tab = document.createElement('button');
          tab.type = 'button';
          tab.className = 'code-tab';
          tab.id = `code-tab-${groupIndex}-${i}`;
          tab.textContent = language.label;
          tab.setAttribute('role', 'tab');
          panel.id = `code-panel-${groupIndex}-${i}`;
          panel.setAttribute('role', 'tabpanel');
          panel.setAttribute('aria-labelledby', tab.id);
          tab.setAttribute('aria-controls', panel.id);
          tab.addEventListener('click', () => choose(language.id, tab));
          tab.addEventListener('keydown', (event) => {
            const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
            if (!(event.key in keys)) return;
            event.preventDefault();
            const next = tabs[(keys[event.key] + tabs.length) % tabs.length];
            next.focus();
            choose(languages[tabs.indexOf(next)], next);
          });
          tabs.push(tab);
          languages.push(language.id);
          tablist.append(tab);
        });
        group.prepend(tablist);
        group.classList.add('is-enhanced');
        tabGroups.push({ tabs, panels, languages });
      });

      function choose(language: string, anchor: HTMLElement) {
        selectLanguage(language, anchor);
        try { localStorage.setItem(LANGUAGE_KEY, language); } catch {}
      }

      if (tabGroups.length > 0) {
        let saved: string | null = null;
        try { saved = localStorage.getItem(LANGUAGE_KEY); } catch {}
        selectLanguage(saved ?? tabGroups[0].languages[0]);
      }
    </script>
  </body>
</html>


<style>
  .site-header { border-bottom: 1px solid var(--af-line); }
  .site-header-inner {
    max-width: var(--af-page-max); margin: 0 auto; padding: 20px var(--af-gutter);
    display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between;
  }
  .site-name { font: 750 1.25rem var(--af-font-display); font-stretch: 115%; text-decoration: none; }
  .site-nav { display: flex; flex-wrap: wrap; gap: 8px 28px; font: 1rem var(--af-font-display); }
  .site-nav a { padding: 10px 0; text-decoration: none; }
  .site-nav a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .site-nav a[aria-current='page'] { padding-bottom: 8px; border-bottom: 2px solid var(--af-ink); font-weight: 700; }
  .site-nav a[aria-current='page']:hover { text-decoration: none; }

  .site-footer { background: var(--af-ink); color: var(--af-paper); font-family: var(--af-font-display); }
  .site-footer a { color: var(--af-paper); text-decoration: none; }
  .site-footer a:hover { color: var(--af-paper); text-decoration: underline; text-underline-offset: 4px; }
  .site-footer a:focus-visible { outline-color: var(--af-boundary-tag); }
  .site-footer-inner {
    max-width: var(--af-page-max); margin: 0 auto; padding: 56px var(--af-gutter) 32px;
    display: flex; flex-wrap: wrap; gap: 40px 64px;
  }
  .site-footer-about { flex: 2 1 300px; min-width: 0; }
  .site-footer-about .site-name { font-size: 1.375rem; }
  .site-footer-about p { margin: 12px 0 0; max-width: 24em; color: var(--af-footer-ink); font: var(--af-supporting)/1.55 var(--af-font-body); }
  .site-footer-links { flex: 1 1 160px; min-width: 0; display: flex; flex-direction: column; gap: 4px; font-size: 0.9375rem; }
  .site-footer-links a { padding: 6px 0; }
  .site-footer-links a.is-security { color: var(--af-boundary-tag); }
  .site-footer-heading { margin-bottom: 6px; font-weight: 700; }
  .site-footer-note {
    max-width: var(--af-page-max); margin: 0 auto; padding: 10px var(--af-gutter) 22px;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 24px;
    border-top: 1px solid var(--af-footer-line); color: var(--af-footer-ink); font-size: 0.875rem;
  }
  @media (max-width: 600px) {
    .site-header-inner, .site-footer-inner, .site-footer-note { padding-left: 20px; padding-right: 20px; }
    /* Four links fit on one row at 320px; the bold current item no longer pushes About to a second line. */
    .site-nav { gap: 8px 20px; }
  }
</style>

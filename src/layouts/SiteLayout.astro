---
const {
  title = 'Agent Fieldnotes — Understand agents. Build them responsibly.',
  description = 'A practical learning path through AI agents, architecture, frameworks, deployment, and security.',
  article = false,
  structuredData = null,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const homeUrl = base.endsWith('/') ? base : `${base}/`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const structuredDataText = structuredData ? JSON.stringify(structuredData).replaceAll('<', '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111310" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f2" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="Agent Fieldnotes" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structuredDataText && <script type="application/ld+json" set:html={structuredDataText}></script>}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${homeUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class:list={{ 'article-page': article }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={homeUrl} aria-label="Agent Fieldnotes home">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>agent<span class="brand-muted">fieldnotes</span></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href={`${homeUrl}learn/`}>Learning path</a>
          <a href={`${homeUrl}learn/#security`}>Security</a>
          <a href={`${homeUrl}about/`}>About</a>
        </nav>
        <div class="header-actions">
          <button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme">
            <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          </button>
          <a class="header-cta" href={`${homeUrl}learn/`}>Explore the guide <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="brand footer-brand" href={homeUrl}>
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>agent<span class="brand-muted">fieldnotes</span></span>
        </a>
        <p>Clear thinking for systems that can act.</p>
        <span class="footer-note">Built to learn in public · <span id="year">2026</span></span>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('.theme-toggle');
      const label = () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        toggle?.setAttribute('aria-label', `Switch to ${next} theme`);
      };
      label();
      toggle?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        label();
      });
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        if (!saved) { root.dataset.theme = event.matches ? 'light' : 'dark'; label(); }
      });
      const year = document.querySelector('#year');
      if (year) year.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #111310; --surface: #171a16; --surface-raised: #1d211b; --surface-2: #141713; --surface-hover: #1b1f19;
    --ink: #f0f0e8; --ink-rgb: 235, 243, 225; --text-body: #d4d8cf; --text-2: #aeb4a9;
    --muted: #a4a99f; --soft: #737b70; --line: rgba(var(--ink-rgb), .12);
    --acid: #c7f36b; --acid-rgb: 199, 243, 107; --acid-fill: #c7f36b; --acid-hover: #d5fa8d; --on-acid: #171a12;
    --cyan: #9ce6db; --cyan-rgb: 156, 230, 219; --dot: #7d9860;
    --glow: rgba(126, 173, 84, .17); --shadow: 0 24px 80px rgba(0, 0, 0, .2);
    --visual-bg: linear-gradient(144deg, rgba(29, 34, 26, .82), rgba(19, 22, 18, .92));
    --feature-bg: linear-gradient(140deg, #232a1c, #171b15 74%);
    --callout-bg: linear-gradient(110deg, rgba(25, 45, 39, .56), rgba(19, 24, 20, .45));
    --code-bg: #0c0e0c; --diagram-bg: #171a16;
    --serif: Georgia, 'Times New Roman', serif;
    font-family: 'DM Sans', system-ui, sans-serif; background: var(--bg); color: var(--ink);
    font-synthesis: none; text-rendering: optimizeLegibility;
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #f6f7f2; --surface: #ffffff; --surface-raised: #eef1e7; --surface-2: #eef1e7; --surface-hover: #fbfcf8;
    --ink: #161a14; --ink-rgb: 22, 26, 20; --text-body: #2b3028; --text-2: #444b40;
    --muted: #50574c; --soft: #61695c;
    --acid: #3f6e0c; --acid-rgb: 63, 110, 12; --acid-fill: #c7f36b; --acid-hover: #b6e651; --on-acid: #171a12;
    --cyan: #0f6b63; --cyan-rgb: 15, 107, 99; --dot: #7d9860;
    --glow: rgba(150, 200, 70, .22); --shadow: 0 24px 60px rgba(22, 26, 20, .08);
    --visual-bg: linear-gradient(144deg, #ffffff, #f1f4ea);
    --feature-bg: linear-gradient(140deg, #eaf5d3, #ffffff 74%);
    --callout-bg: linear-gradient(110deg, #e3f3ef, #f6f7f2);
    --code-bg: #eef1e7;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) {
    color-scheme: light;
    --bg: #f6f7f2; --surface: #ffffff; --surface-raised: #eef1e7; --surface-2: #eef1e7; --surface-hover: #fbfcf8;
    --ink: #161a14; --ink-rgb: 22, 26, 20; --text-body: #2b3028; --text-2: #444b40;
    --muted: #50574c; --soft: #61695c;
    --acid: #3f6e0c; --acid-rgb: 63, 110, 12; --acid-fill: #c7f36b; --acid-hover: #b6e651; --on-acid: #171a12;
    --cyan: #0f6b63; --cyan-rgb: 15, 107, 99; --dot: #7d9860;
    --glow: rgba(150, 200, 70, .22); --shadow: 0 24px 60px rgba(22, 26, 20, .08);
    --visual-bg: linear-gradient(144deg, #ffffff, #f1f4ea);
    --feature-bg: linear-gradient(140deg, #eaf5d3, #ffffff 74%);
    --callout-bg: linear-gradient(110deg, #e3f3ef, #f6f7f2);
    --code-bg: #eef1e7;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; background: var(--bg); }
  a { color: inherit; text-decoration: none; }
  button, input { font: inherit; }
  .skip-link { position: absolute; top: -60px; left: 16px; z-index: 10; padding: 10px 14px; color: var(--on-acid); background: var(--acid-fill); }
  .skip-link:focus { top: 12px; }
  .site-header { height: 76px; border-bottom: 1px solid var(--line); }
  .header-inner, .footer-inner { width: min(1160px, calc(100% - 56px)); margin: 0 auto; height: 100%; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font: 700 15px 'Manrope', sans-serif; letter-spacing: -.045em; }
  .brand-muted { color: var(--muted); font-weight: 500; }
  .brand-mark { width: 22px; height: 22px; display: inline-flex; align-items: end; gap: 3px; }
  .brand-mark span { display: block; width: 5px; border-radius: 5px 5px 2px 2px; background: var(--acid-fill); }
  :root[data-theme="light"] .brand-mark span { background: #8cc63f; }
  .brand-mark span:nth-child(1) { height: 9px; opacity: .72; } .brand-mark span:nth-child(2) { height: 16px; } .brand-mark span:nth-child(3) { height: 12px; opacity: .84; }
  .main-nav { display: flex; gap: 34px; align-items: center; color: var(--text-2); font-size: 13px; }
  .main-nav a:hover, .main-nav a:focus-visible { color: var(--acid); }
  .header-cta { display: flex; align-items: center; gap: 12px; padding: 11px 15px; border: 1px solid var(--line); border-radius: 3px; font: 500 12px 'DM Mono', monospace; color: var(--acid); }
  .header-cta:hover { background: rgba(var(--acid-rgb), .08); border-color: rgba(var(--acid-rgb), .45); }
  .header-actions { display: flex; align-items: center; gap: 10px; }
  .theme-toggle { display: inline-grid; place-items: center; width: 38px; height: 38px; padding: 0; border: 1px solid var(--line); border-radius: 3px; background: transparent; color: var(--muted); cursor: pointer; }
  .theme-toggle:hover, .theme-toggle:focus-visible { color: var(--acid); border-color: rgba(var(--acid-rgb), .45); }
  .theme-toggle:focus-visible { outline: 2px solid var(--acid); outline-offset: 2px; }
  .theme-toggle .icon-moon { display: none; }
  :root[data-theme="light"] .theme-toggle .icon-moon { display: block; } :root[data-theme="light"] .theme-toggle .icon-sun { display: none; }
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero::before { content: ''; position: absolute; width: 620px; height: 620px; top: -270px; right: -120px; pointer-events: none; background: radial-gradient(circle, var(--glow), transparent 66%); }
  .hero-inner { position: relative; width: min(1160px, calc(100% - 56px)); margin: 0 auto; padding: 87px 0 76px; display: grid; grid-template-columns: 1.2fr .8fr; gap: 58px; align-items: center; }
  .eyebrow { display: inline-flex; gap: 10px; align-items: center; font: 11px 'DM Mono', monospace; letter-spacing: .09em; text-transform: uppercase; color: var(--acid); }
  .eyebrow::before { content: ''; width: 23px; height: 1px; background: var(--acid); }
  h1, h2, h3, p { margin-top: 0; }
  .hero h1 { max-width: 650px; margin: 23px 0 21px; font: 500 clamp(48px, 6.5vw, 82px)/.98 'Manrope', sans-serif; letter-spacing: -.075em; }
  .hero h1 em { color: var(--acid); font-family: var(--serif); font-weight: 400; }
  .hero-copy { max-width: 535px; margin-bottom: 29px; color: var(--text-2); font-size: 16px; line-height: 1.72; }
  .hero-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .button-primary, .button-quiet { display: inline-flex; justify-content: center; align-items: center; gap: 16px; padding: 14px 17px; border-radius: 3px; font: 500 12px 'DM Mono', monospace; }
  .button-primary { background: var(--acid-fill); color: var(--on-acid); } .button-primary:hover { background: var(--acid-hover); }
  .button-quiet { color: var(--text-body); border: 1px solid var(--line); } .button-quiet:hover { border-color: rgba(var(--ink-rgb), .36); }
  .hero-note { display: flex; align-items: center; gap: 9px; margin-top: 27px; color: var(--soft); font: 10px 'DM Mono', monospace; letter-spacing: .05em; text-transform: uppercase; }
  .hero-note span { color: var(--cyan); }
  .hero-visual { position: relative; min-height: 310px; padding: 25px; border: 1px solid rgba(var(--ink-rgb), .16); background: var(--visual-bg); box-shadow: var(--shadow); }
  .visual-top { display: flex; justify-content: space-between; color: var(--soft); font: 10px 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .1em; }
  .visual-top .live { color: var(--acid); }
  .loop-diagram { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 13px; margin: 36px 5px 28px; }
  .loop-step { min-height: 76px; padding: 15px 14px; border: 1px solid rgba(var(--ink-rgb), .14); background: rgba(var(--ink-rgb), .025); }
  .loop-step b { display: block; margin-bottom: 8px; color: var(--ink); font: 500 12px 'DM Mono', monospace; }
  .loop-step small { color: var(--soft); font-size: 11px; } .loop-step .num { color: var(--acid); margin-right: 9px; }
  .loop-arrow { position: absolute; color: var(--acid); font: 15px 'DM Mono', monospace; }
  .loop-arrow.a { top: 22%; left: 47%; } .loop-arrow.b { bottom: 22%; left: 47%; }
  .visual-caption { display: flex; gap: 9px; align-items: start; color: var(--soft); font-size: 11px; line-height: 1.5; }
  .visual-caption span { color: var(--cyan); }
  .signal-row { border-bottom: 1px solid var(--line); }
  .signal-inner { width: min(1160px, calc(100% - 56px)); margin: 0 auto; display: flex; gap: 16px; align-items: center; padding: 18px 0; color: var(--soft); font: 10px 'DM Mono', monospace; letter-spacing: .09em; text-transform: uppercase; }
  .signal-inner strong { color: var(--text-body); font-weight: 400; } .signal-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--dot); }
  .section { width: min(1160px, calc(100% - 56px)); margin: 0 auto; padding: 78px 0; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin-bottom: 27px; }
  .section-heading h2 { margin: 11px 0 0; font: 500 clamp(29px, 3.3vw, 43px)/1.12 'Manrope', sans-serif; letter-spacing: -.055em; }
  .section-heading p { max-width: 390px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
  .featured-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 16px; }
  .feature-panel { position: relative; overflow: hidden; min-height: 300px; display: flex; align-items: end; padding: 31px; border: 1px solid rgba(var(--acid-rgb), .25); background: var(--feature-bg); }
  .feature-panel::after { content: '01'; position: absolute; right: 28px; top: 9px; color: rgba(var(--acid-rgb), .13); font: 100px 'Manrope', sans-serif; letter-spacing: -.1em; }
  .feature-content { position: relative; z-index: 1; max-width: 570px; } .feature-content .topic-label { color: var(--acid); }
  .feature-content h3 { max-width: 500px; margin: 15px 0 11px; font: 500 clamp(30px, 4vw, 47px)/1.04 'Manrope', sans-serif; letter-spacing: -.06em; }
  .feature-content p { max-width: 490px; margin-bottom: 20px; color: var(--text-2); font-size: 13px; line-height: 1.7; }
  .feature-link { display: inline-flex; gap: 12px; align-items: center; color: var(--acid); font: 11px 'DM Mono', monospace; }
  .featured-grid > .article-card { min-height: 300px; border-color: rgba(var(--acid-rgb), .25); background: var(--feature-bg); }
  .featured-grid > .article-card .article-card-link { min-height: 300px; padding: 31px; justify-content: end; }
  .featured-grid > .article-card h3 { max-width: 500px; margin: 18px 0 11px; font: 500 clamp(30px, 4vw, 47px)/1.04 'Manrope', sans-serif; letter-spacing: -.06em; }
  .featured-grid > .article-card p { max-width: 490px; font-size: 13px; }
  .featured-grid > .article-card .article-card-meta { color: var(--acid); }
  .feature-aside { border: 1px solid var(--line); background: var(--surface-2); padding: 26px; display: flex; flex-direction: column; justify-content: space-between; }
  .feature-aside .aside-index { color: var(--soft); font: 10px 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .1em; }
  .feature-aside h3 { margin: 30px 0 12px; font: 500 27px/1.14 'Manrope', sans-serif; letter-spacing: -.05em; }
  .feature-aside p { color: var(--muted); font-size: 12px; line-height: 1.65; }
  .aside-rule { height: 1px; margin: 21px 0; background: var(--line); }
  .article-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .article-card { border: 1px solid var(--line); background: var(--surface); transition: border-color .2s, transform .2s, background .2s; }
  .article-card:hover { transform: translateY(-3px); border-color: rgba(var(--acid-rgb), .42); background: var(--surface-hover); }
  .article-card-link { min-height: 218px; height: 100%; display: flex; flex-direction: column; padding: 21px; }
  .article-card-meta, .article-card-foot { display: flex; justify-content: space-between; gap: 12px; color: var(--soft); font: 10px 'DM Mono', monospace; }
  .topic-label { color: var(--cyan); }
  .article-card h3 { margin: 26px 0 9px; font: 500 20px/1.2 'Manrope', sans-serif; letter-spacing: -.035em; }
  .article-card p { margin: 0 0 22px; color: var(--muted); font-size: 12px; line-height: 1.6; }
  .article-card-foot { margin-top: auto; align-items: center; } .arrow { margin-left: auto; color: var(--acid); font-size: 14px; }
  .path-section { border-top: 1px solid var(--line); background: var(--surface-2); }
  .path-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin-top: 38px; border: 1px solid var(--line); }
  .path-step { min-height: 165px; padding: 20px 18px; border-right: 1px solid var(--line); }
  .path-step:last-child { border-right: 0; } .path-number { color: var(--acid); font: 11px 'DM Mono', monospace; }
  .path-step h3 { margin: 25px 0 8px; font: 600 14px 'Manrope', sans-serif; } .path-step p { margin: 0; color: var(--soft); font-size: 11px; line-height: 1.5; }
  .security-callout { width: min(1160px, calc(100% - 56px)); margin: 0 auto 78px; display: grid; grid-template-columns: 1fr auto; gap: 25px; align-items: center; padding: 30px 34px; border: 1px solid rgba(var(--cyan-rgb), .18); background: var(--callout-bg); }
  .security-callout h2 { margin: 0 0 7px; font: 500 25px 'Manrope', sans-serif; letter-spacing: -.04em; }
  .security-callout p { max-width: 670px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .security-callout .button-quiet { border-color: rgba(var(--cyan-rgb), .27); color: var(--cyan); }
  .site-footer { border-top: 1px solid var(--line); }
  .footer-inner { min-height: 82px; gap: 20px; } .footer-inner p, .footer-note { margin: 0; color: var(--soft); font-size: 11px; }
  .footer-note { font: 10px 'DM Mono', monospace; }
  .page-intro { width: min(1160px, calc(100% - 56px)); margin: 0 auto; padding: 76px 0 37px; }
  .page-intro h1 { margin: 17px 0 12px; font: 500 clamp(42px, 6vw, 68px)/1 'Manrope', sans-serif; letter-spacing: -.07em; }
  .page-intro p { max-width: 650px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .topic-section { width: min(1160px, calc(100% - 56px)); margin: 0 auto; padding: 25px 0 60px; }
  .topic-heading { display: flex; align-items: baseline; gap: 14px; padding-bottom: 14px; margin-bottom: 17px; border-bottom: 1px solid var(--line); }
  .topic-heading h2 { margin: 0; font: 500 25px 'Manrope', sans-serif; letter-spacing: -.04em; } .topic-heading span { color: var(--soft); font: 10px 'DM Mono', monospace; }
  .empty-state { padding: 38px; border: 1px dashed var(--line); color: var(--muted); text-align: center; }
  .article-hero { border-bottom: 1px solid var(--line); }
  .article-hero-inner { width: min(1050px, calc(100% - 56px)); margin: auto; padding: 61px 0 40px; }
  .breadcrumbs { display: flex; gap: 9px; margin-bottom: 27px; color: var(--soft); font: 10px 'DM Mono', monospace; }
  .breadcrumbs a:hover { color: var(--acid); }
  .article-hero h1 { max-width: 850px; margin: 16px 0 14px; font: 500 clamp(42px, 6.2vw, 68px)/1.03 'Manrope', sans-serif; letter-spacing: -.07em; }
  .article-dek { max-width: 730px; margin: 0; color: var(--text-2); font-size: 17px; line-height: 1.65; }
  .article-byline { display: flex; gap: 16px; align-items: center; margin-top: 24px; color: var(--soft); font: 10px 'DM Mono', monospace; }
  .article-byline .topic-label { padding: 6px 8px; border: 1px solid rgba(var(--cyan-rgb), .18); }
  .article-shell { display: grid; grid-template-columns: minmax(0, 710px) 205px; gap: 78px; width: min(1050px, calc(100% - 56px)); margin: 0 auto; padding: 52px 0 90px; }
  .prose { color: var(--text-body); font-size: 16px; line-height: 1.86; }
  .prose > :first-child { margin-top: 0; }
  .prose h2 { margin: 44px 0 16px; color: var(--ink); font: 600 27px/1.18 'Manrope', sans-serif; letter-spacing: -.045em; }
  .prose h3 { margin: 33px 0 12px; color: var(--ink); font: 600 20px 'Manrope', sans-serif; letter-spacing: -.03em; }
  .prose p { margin: 0 0 20px; }
  .prose a { color: var(--acid); text-decoration: underline; text-decoration-color: rgba(var(--acid-rgb), .35); text-underline-offset: 3px; }
  .prose a:hover { text-decoration-color: var(--acid); }
  .prose ul, .prose ol { padding-left: 24px; margin: 0 0 22px; } .prose li { padding-left: 4px; margin: 0 0 8px; }

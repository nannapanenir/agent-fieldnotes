---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found — Agent Fieldnotes">
  <section class="not-found">
    <span class="eyebrow">404 / not found</span>
    <h1>This fieldnote is missing.</h1>
    <p>The article may have moved or the route may be mistyped.</p>
    <a class="button-primary" href={`${import.meta.env.BASE_URL}learn/`}>Browse the learning path <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>

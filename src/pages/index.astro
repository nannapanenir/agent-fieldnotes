---
import SiteLayout from '../layouts/SiteLayout.astro';
import { articleHref, articlesInTopic, getPublishedArticles, latestArticles, type Article } from '../lib/articles';
import { learningPath, stageHref } from '../lib/learning-path';

const articles = await getPublishedArticles();
const byId = new Map(articles.map((article) => [article.id, article]));
const shortTitle = (title: string) => title.split(':')[0];

// The three notes the rest of the site builds on.
const START_HERE = ['foundations/what-is-an-agent', 'architecture/the-agent-loop', 'security/trust-boundaries-for-agents'];
const startHere = START_HERE.map((id) => byId.get(id)).filter((article): article is Article => article !== undefined);
const basics = startHere[0];

const { stages, publishedCount, plannedCount } = learningPath(articles);
const security = latestArticles(articlesInTopic(articles, 'Security'), 4);

const base = import.meta.env.BASE_URL;
const siteSchema = Astro.site ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Agent Fieldnotes',
  description: 'A practical learning path through AI agents, architecture, frameworks, deployment, and security.',
  url: Astro.site.toString(),
} : null;
---

<SiteLayout structuredData={siteSchema}>
  <section class="hero">
    <div class="hero-text">
      <h1>How AI agents work, and how to keep them inside their limits.</h1>
      <p class="hero-lead">Plain explanations of the agent loop, tools, memory and orchestration, with working code in TypeScript and Python. Security is drawn into every diagram, not added at the end.</p>
      <div class="hero-actions">
        {basics && <a class="button button-primary" href={articleHref(basics)}>Start with the basics</a>}
        <a class="button button-secondary" href={`${base}learn/`}>See the learning path</a>
      </div>
    </div>

    <figure class="hero-figure">
      <div class="sheet">
        <div class="boundary">
          <span class="boundary-tag">Permission boundary</span>
          <div class="loop">
            <ol class="loop-steps">
              <li class="step step-observe"><span class="step-number">Step 1</span><span class="step-name">Observe</span></li>
              <li class="step step-decide"><span class="step-number">Step 2</span><span class="step-name">Decide</span></li>
              <li class="step step-check"><span class="step-number">Step 3</span><span class="step-name">Check</span></li>
              <li class="step step-act"><span class="step-number">Step 4</span><span class="step-name">Act</span></li>
            </ol>
            <svg class="arrow arrow-right" aria-hidden="true" width="40" height="16" viewBox="0 0 40 16"><path d="M2 8h32M28 3l6 5-6 5" /></svg>
            <svg class="arrow arrow-down" aria-hidden="true" width="16" height="40" viewBox="0 0 16 40"><path d="M8 2v32M3 28l5 6 5-6" /></svg>
            <svg class="arrow arrow-left" aria-hidden="true" width="40" height="16" viewBox="0 0 40 16"><path d="M38 8H6M12 3L6 8l6 5" /></svg>
            <svg class="arrow arrow-up" aria-hidden="true" width="16" height="40" viewBox="0 0 16 40"><path d="M8 38V6M3 12l5-6 5 6" /></svg>
          </div>
        </div>
        <ul class="tools" aria-label="Tools">
          <li>search_docs: allowed</li>
          <li>read_file: allowed</li>
          <li class="tool-blocked">send_email: blocked</li>
        </ul>
      </div>
      <figcaption>Figure 1. The agent loop. Every action passes the check before it reaches a tool, and only listed tools sit inside the boundary.</figcaption>
    </figure>
  </section>

  <section class="band" aria-labelledby="start-here">
    <div class="band-inner">
      <h2 id="start-here">Start here</h2>
      <p class="band-lead">Three notes that the rest of the site builds on.</p>
      <div class="start-grid">
        {startHere.map((article) => (
          <a class:list={['start-card', { 'is-security': article.data.topic === 'Security' }]} href={articleHref(article)}>
            <span class="start-topic">{article.data.topic}</span>
            <span class="start-title">{shortTitle(article.data.title)}</span>
            <span class="start-summary">{article.data.description}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-raised" id="learning-path" aria-labelledby="learning-path-title">
    <div class="band-inner">
      <div class="path-heading">
        <h2 id="learning-path-title">The learning path</h2>
        <p>{publishedCount} notes published of {plannedCount} planned</p>
      </div>
      <ol class="path">
        {stages.map((stage) => {
          const href = stageHref(stage);
          const label = `Sheet ${stage.number} of ${stages.length}, ${stage.status}`;
          return (
            <li class:list={['sheet-card', `is-${stage.status.replace(' ', '-')}`]}>
              {href ? (
                <a href={href}><span class="sheet-label">{label}</span><span class="sheet-name">{stage.name}</span></a>
              ) : (
                <div><span class="sheet-label">{label}</span><span class="sheet-name">{stage.name}</span></div>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="security-title">
    <div class="band-inner security">
      <div class="security-intro">
        <h2 id="security-title">Every tool sits behind a boundary.</h2>
        <p>The security notes use the same drawings as the architecture notes, so you can see exactly where a check belongs.</p>
        <a class="security-all" href={`${base}learn/#security`}>All security notes</a>
      </div>
      <ul class="security-list">
        {security.map((article) => <li><a href={articleHref(article)}>{shortTitle(article.data.title)}</a></li>)}
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    max-width: var(--af-page-max); margin: 0 auto; padding: var(--af-section-pad) var(--af-gutter) 88px;
    display: flex; flex-wrap: wrap; gap: 56px; align-items: center;
  }
  .hero-text { flex: 1 1 420px; min-width: 0; }
  h1 { margin: 0; font: 800 var(--af-h1)/1.02 var(--af-font-display); font-stretch: var(--af-stretch-h1); letter-spacing: -0.01em; }
  .hero-lead { margin: 28px 0 0; max-width: 34em; color: var(--af-ink-soft); font-size: var(--af-lead); line-height: 1.6; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .button { border-radius: var(--af-radius); font: 600 16px var(--af-font-display); text-decoration: none; }
  .button-primary { padding: 14px 22px; background: var(--af-ink); color: var(--af-paper); }
  .button-primary:hover { background: var(--af-ink-strong); color: var(--af-paper); }
  .button-secondary { padding: 12.5px 22px; border: 1.5px solid var(--af-ink); }
  .button-secondary:hover { background: var(--af-paper-raised); }

  .hero-figure { flex: 1 1 460px; min-width: 0; margin: 0; font-family: var(--af-font-display); }
  .sheet {
    padding: 40px 28px 28px; border: 1px solid var(--af-line);
    background-color: var(--af-paper-raised);
    background-image: linear-gradient(var(--af-grid) 1px, transparent 1px), linear-gradient(90deg, var(--af-grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .boundary { position: relative; padding: 36px 24px 24px; border: 2px dashed var(--af-boundary); }
  .boundary-tag {
    position: absolute; top: -14px; left: 18px; padding: 4px 10px;
    background: var(--af-boundary-tag); color: var(--af-ink); font-weight: 700; font-size: 13px;
  }
  .loop {
    display: grid; align-items: center;
    grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr); grid-template-rows: auto 40px auto;
  }
  .loop-steps { display: contents; list-style: none; }
  .step { display: flex; flex-direction: column; padding: 14px 16px; border: 1.5px solid var(--af-ink); background: var(--af-paper); }
  .step-number { color: var(--af-muted); font-size: 13px; }
  .step-name { font-weight: 700; font-size: 20px; }
  .step-observe { grid-area: 1 / 1; }
  .step-decide { grid-area: 1 / 3; }
  .step-check { grid-area: 3 / 3; border: 2px solid var(--af-boundary); background: var(--af-boundary-bg); }
  .step-check .step-number { color: var(--af-boundary-ink); }
  .step-act { grid-area: 3 / 1; }
  .arrow { justify-self: center; fill: none; stroke: var(--af-ink); stroke-width: 1.5; }
  .arrow-right { grid-area: 1 / 2; }
  .arrow-down { grid-area: 2 / 3; }
  .arrow-left { grid-area: 3 / 2; }
  .arrow-up { grid-area: 2 / 1; }
  .tools { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 0; padding: 0; list-style: none; font-size: 14px; }
  .tools li { padding: 6px 10px; border: 1px solid var(--af-line); background: var(--af-paper); }
  .tools .tool-blocked { border-style: dashed; background: transparent; color: var(--af-muted); text-decoration: line-through; }
  figcaption { margin-top: 12px; color: var(--af-muted); font: var(--af-meta)/1.5 var(--af-font-body); }

  .band { border-top: 1px solid var(--af-line); }
  .band-raised { background: var(--af-paper-raised); }
  .band-inner { max-width: var(--af-page-max); margin: 0 auto; padding: var(--af-section-pad) var(--af-gutter); }
  h2 { margin: 0 0 8px; font: 750 36px/1.1 var(--af-font-display); font-stretch: var(--af-stretch-h2); }
  .band-lead { margin: 0 0 32px; max-width: 36em; color: var(--af-ink-soft); font-size: 18px; }

  .start-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px;
    border: 1.5px solid var(--af-ink); background: var(--af-line);
  }
  .start-card { display: flex; flex-direction: column; gap: 12px; padding: 24px; background: var(--af-paper); text-decoration: none; }
  .start-card.is-security { background: var(--af-boundary-bg); }
  .start-card:hover .start-title { text-decoration: underline; text-underline-offset: 4px; }
  .start-card:focus-visible { outline-offset: -4px; }
  .start-topic { color: var(--af-muted); font: 14px var(--af-font-display); }
  .start-card.is-security .start-topic { color: var(--af-boundary-ink); }
  .start-title { font: 700 24px/1.2 var(--af-font-display); }
  .start-summary { color: var(--af-ink-soft); font-size: 17px; line-height: 1.55; }

  .path-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 32px; margin-bottom: 32px; }
  .path-heading h2 { margin: 0; }
  .path-heading p { margin: 0; color: var(--af-ink-soft); font-size: 17px; }
  .path { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .sheet-card { font-family: var(--af-font-display); }
  .sheet-card > * { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 18px 20px; text-decoration: none; }
  .sheet-card a:hover .sheet-name { text-decoration: underline; text-underline-offset: 4px; }
  .sheet-card a:focus-visible { outline-offset: 2px; }
  .sheet-label { color: var(--af-muted); font-size: 13px; }
  .sheet-name { font-weight: 700; font-size: 20px; }
  .is-published { border: 1.5px solid var(--af-ink); background: var(--af-paper); }
  .is-in-progress { border: 1.5px dashed var(--af-ink); }
  .is-planned { border: 1px dashed var(--af-line); color: var(--af-muted); }

  .security { display: flex; flex-wrap: wrap; gap: 48px; }
  .security-intro { flex: 1 1 340px; min-width: 0; }
  .security-intro h2 { margin: 0; }
  .security-intro p { margin: 20px 0 0; max-width: 30em; color: var(--af-ink-soft); font-size: 18px; line-height: 1.6; }
  .security-all { display: inline-block; margin-top: 20px; padding: 6px 0; color: var(--af-boundary-ink); font: 600 16px var(--af-font-display); text-underline-offset: 4px; }
  .security-all:hover { color: var(--af-boundary-ink); }
  .security-list { flex: 1 1 480px; min-width: 0; margin: 0; padding: 0; list-style: none; border-top: 2px dashed var(--af-boundary); }
  .security-list li { border-bottom: 1px solid var(--af-line); }
  .security-list a { display: block; padding: 20px 0; font: 650 21px/1.3 var(--af-font-display); text-decoration: none; }
  .security-list a:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 600px) {
    .hero { padding: 48px 20px 64px; gap: 40px; }
    .hero-text, .hero-figure { flex-basis: 100%; }
    .band-inner { padding: 56px 20px; }
    h2 { font-size: 30px; }
    .sheet { padding: 28px 12px 12px; }
    .boundary { padding: 32px 12px 16px; }
    .step { padding: 10px 12px; }
    .step-name { font-size: 17px; }
    .start-grid { grid-template-columns: 1fr; }
    .security-intro, .security-list { flex-basis: 100%; }
  }
</style>

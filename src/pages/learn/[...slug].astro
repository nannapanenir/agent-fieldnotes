---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { articleHref, getPublishedArticles } from '../../lib/articles';
import { learningPath, pathPosition, stageAnchor } from '../../lib/learning-path';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const formatDate = (value: Date) => value.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const date = formatDate(article.data.publishedAt);
const updated = article.data.updatedAt && article.data.updatedAt > article.data.publishedAt ? article.data.updatedAt : undefined;
const { stages } = learningPath(await getPublishedArticles());
const position = pathPosition(stages, article);
const minutes = (entry: typeof article) => `${entry.data.readingMinutes ?? 5} min`;
// "2.1": the stage number and the note's place in that stage, as on /learn/.
const noteNumber = (entry: typeof article) => {
  const stage = stages.find((candidate) => candidate.notes.some((note) => note.id === entry.id));
  return stage ? `${stage.number}.${stage.notes.findIndex((note) => note.id === entry.id) + 1}` : undefined;
};
const isSecurity = article.data.topic === 'Security';
const base = import.meta.env.BASE_URL;
const topicSlug = article.data.topic.toLowerCase();
const toc = headings.filter((heading) => heading.depth === 2).map((heading) => ({ ...heading, security: /secur/i.test(heading.text) }));
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: article.data.title,
      description: article.data.description,
      datePublished: article.data.publishedAt.toISOString(),
      ...(article.data.updatedAt ? { dateModified: article.data.updatedAt.toISOString() } : {}),
      ...(canonicalUrl ? { mainEntityOfPage: canonicalUrl } : {}),
      articleSection: article.data.topic,
      keywords: article.data.tags,
      isPartOf: Astro.site ? { '@type': 'WebSite', name: 'Agent Fieldnotes', url: Astro.site.toString() } : undefined,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
        { '@type': 'ListItem', position: 2, name: 'Learning path', item: Astro.site ? new URL(`${base}learn/`, Astro.site).toString() : undefined },
        { '@type': 'ListItem', position: 3, name: position ? `Stage ${position.stage.number}: ${position.stage.name}` : article.data.topic, item: Astro.site ? new URL(position ? `${base}learn/#stage-${position.stage.number}` : `${base}learn/#${topicSlug}`, Astro.site).toString() : undefined },
        { '@type': 'ListItem', position: 4, name: article.data.title, item: canonicalUrl },
      ],
    },
  ],
};
---

<SiteLayout title={`${article.data.title} — Agent Fieldnotes`} description={article.data.description} article structuredData={articleSchema}>
  <header class="layout article-head">
    <div class="main">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={base}>Home</a><span aria-hidden="true">/</span><a href={`${base}learn/`}>Learning path</a><span aria-hidden="true">/</span>{position
          ? <a href={stageAnchor(position.stage)}>Stage {position.stage.number}: {position.stage.name}</a>
          : <a href={`${base}learn/#${topicSlug}`}>{article.data.topic}</a>}
      </nav>
      <h1>{article.data.title}</h1>
      <p class="summary">{article.data.description}</p>
      <div class="meta">
        {position && <span class="meta-path">Stage {position.stage.number} · Note {noteNumber(article)} of {position.count}</span>}
        {isSecurity && <span class="meta-security">Security</span>}
        <span>{article.data.level}</span>
        <span>{minutes(article)} read</span>
        <span>Published <time datetime={article.data.publishedAt.toISOString().slice(0, 10)}>{date}</time></span>
        {updated && <span>Updated <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time></span>}
      </div>
    </div>
  </header>
  <hr class="divider" />
  <div class="layout article-body">
    <aside class="toc" aria-label="On this page">
      <div class="toc-title">On this page</div>
      <nav class="toc-list">
        {toc.map((heading) => <a class:list={{ 'is-security': heading.security }} href={`#${heading.slug}`}>{heading.text}</a>)}
      </nav>
      <a class="back-link" href={`${base}learn/`}><svg class="back-arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M24 6H2M7 1L2 6l5 5" /></svg>Learning path</a>
    </aside>
    <div class="main">
      <article class="prose"><Content /></article>
      {position && (
        <nav class="path-nav" aria-label="Learning path">
          {position.next ? (
            <a class="path-next" href={articleHref(position.next)}>
              <span class="path-label">Next in the path · Note {noteNumber(position.next)}</span>
              <span class="path-title">{position.next.data.title}<svg class="path-arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M0 6h22M17 1l5 5-5 5" /></svg></span>
              <span class="path-meta">{position.next.data.level} · {minutes(position.next)}</span>
            </a>
          ) : (
            <a class="path-next" href={`${base}learn/`}>
              <span class="path-label">End of the path</span>
              <span class="path-title">Back to the learning path<svg class="path-arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M0 6h22M17 1l5 5-5 5" /></svg></span>
              <span class="path-meta">All eight stages and every note</span>
            </a>
          )}
          {position.previous && (
            <a class="path-previous" href={articleHref(position.previous)}>
              <span class="path-previous-label">Previous · Note {noteNumber(position.previous)}</span>
              <span>{position.previous.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </div>
</SiteLayout>

<script>
  // Diagram frames scroll sideways on narrow screens. When a frame overflows, a visible "Scroll" cue
  // sits above it; the frame's aria-label already says this for screen readers.
  const ARROW = '<svg viewBox="0 0 24 12" aria-hidden="true"><path d="M0 6h22M17 1l5 5-5 5" /></svg>';
  for (const frame of Array.from(document.querySelectorAll<HTMLElement>('.prose .diagram-frame'))) {
    const cue = document.createElement('p');
    cue.className = 'scroll-cue';
    cue.setAttribute('aria-hidden', 'true');
    cue.innerHTML = `Scroll ${ARROW}`;
    frame.before(cue);
    const update = () => {
      cue.hidden = frame.scrollWidth <= frame.clientWidth + 1;
      cue.classList.toggle('is-at-end', frame.scrollLeft + frame.clientWidth >= frame.scrollWidth - 1);
    };
    new ResizeObserver(update).observe(frame);
    frame.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<script>
  // Marks the On this page link for the section being read.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-list a'));
  const sections = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((heading): heading is HTMLElement => heading !== null);
  let frame = 0;
  const update = () => {
    frame = 0;
    const line = window.innerHeight * 0.25;
    let current = -1;
    sections.forEach((heading, index) => { if (heading.getBoundingClientRect().top <= line) current = index; });
    // Short closing sections never reach the line; at the bottom of the page, the last one is current.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = sections.length - 1;
    links.forEach((link, index) => {
      if (index === current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  if (sections.length > 0) {
    addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .layout {
    max-width: 1400px; margin: 0 auto; padding: 56px var(--af-gutter) 0;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, var(--af-measure)) minmax(0, 1fr);
    column-gap: 56px; row-gap: 48px; align-items: start;
  }
  .main { grid-column: 2; grid-row: 1; min-width: 0; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; color: var(--af-muted); font: var(--af-meta) var(--af-font-display); }
  .breadcrumbs a { color: var(--af-muted); }
  .breadcrumbs a:hover { color: var(--af-ink); }
  h1 { margin: 28px 0 0; font: 800 var(--af-h1)/1.02 var(--af-font-display); font-stretch: var(--af-stretch-h1); overflow-wrap: break-word; }
  .summary { margin: 20px 0 0; color: var(--af-ink-soft); font-size: 1.3125rem; line-height: 1.55; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 24px; color: var(--af-muted); font: var(--af-meta) var(--af-font-display); }
  .meta-path { color: var(--af-ink); font-weight: 600; }
  .meta-security { color: var(--af-boundary-ink); font-weight: 600; }
  .divider { margin: 48px 0 0; border: 0; border-top: 1px solid var(--af-line); }
  .article-body { padding-bottom: 96px; }

  /* Next in the path: a published sheet card, so the path reads as part of the drawing set. */
  .path-nav { display: flex; flex-direction: column; gap: 16px; margin-top: 64px; padding-top: 32px; border-top: 1.5px solid var(--af-ink); font-family: var(--af-font-display); }
  .path-next { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px; border: 1.5px solid var(--af-ink); background: var(--af-paper-raised); text-decoration: none; }
  .path-label, .path-previous-label { color: var(--af-muted); font-size: 0.875rem; }
  .path-title { display: flex; align-items: baseline; gap: 12px; font-weight: 700; font-size: 1.375rem; line-height: 1.25; }
  .path-arrow { flex: none; width: 24px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .path-meta { color: var(--af-ink-soft); font-size: 0.9375rem; }
  .path-next:hover .path-title { text-decoration: underline; text-underline-offset: 4px; }
  .path-previous { display: flex; flex-direction: column; gap: 2px; align-self: flex-start; padding: 6px 0; font-size: 1rem; font-weight: 600; line-height: 1.35; text-decoration: none; }
  .path-previous-label { font-weight: 400; }
  .path-previous:hover span:last-child { text-decoration: underline; text-underline-offset: 3px; }

  .toc { grid-column: 3; grid-row: 1; max-width: 240px; min-width: 0; position: sticky; top: 24px; font-family: var(--af-font-display); font-size: var(--af-meta); }
  .toc-title { margin-bottom: 12px; font-weight: 700; }
  .toc-list { display: flex; flex-direction: column; padding-left: 16px; border-left: 1.5px solid var(--af-line); }
  .toc-list a { margin-left: -17.5px; padding: 6px 0 6px 16px; border-left: 3px solid transparent; color: var(--af-ink-soft); line-height: 1.4; text-decoration: none; }
  .toc-list a:hover { color: var(--af-ink); text-decoration: underline; text-underline-offset: 3px; }
  .toc-list a.is-security { color: var(--af-boundary-ink); }
  .toc-list a[aria-current] { border-left-color: var(--af-ink); color: var(--af-ink); font-weight: 700; }
  .back-arrow { width: 20px; height: 10px; margin-right: 8px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .back-link { display: inline-flex; align-items: center; margin-top: 24px; padding: 8px 0; font-weight: 600; text-decoration: none; }
  .back-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 1040px) {
    .layout { grid-template-columns: minmax(0, var(--af-measure)); justify-content: center; }
    .main, .toc { grid-column: 1; }
    .toc { grid-row: 1; max-width: none; position: static; }
    .article-body .main { grid-row: 2; }
  }
  @media (max-width: 600px) {
    .layout { padding: 40px 20px 0; row-gap: 40px; }
    .summary { font-size: 1.1875rem; }
    .divider { margin-top: 40px; }
    .article-body { padding-bottom: 72px; }
  }
</style>
